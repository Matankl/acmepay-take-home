# Copy this file to .env and fill in your model + provider key.
#   cp .env.example .env
#
# Any provider litellm supports works (OpenAI, Anthropic, Gemini free tier,
# local, ...). Set LLM_MODEL and the ONE matching provider key below.
# The .env file is gitignored — never commit a real key.

# The model litellm will call. Default matches the starter.
LLM_MODEL=gpt-4o-mini

# Set the key that matches your LLM_MODEL's provider (leave the others blank):
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
